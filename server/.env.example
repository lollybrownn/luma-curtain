NODE_ENV=development
HTTP_PORT=3001
CLIENT_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=lumacurtain
MYSQL_USER=lumacurtain_user
MYSQL_PASSWORD=GANTI_DENGAN_PASSWORD_MYSQL
JWT_SECRET=GANTI_DENGAN_RANDOM_MINIMAL_32_KARAKTER

# EMQX Cloud Dedicated Flex (MQTT over TLS)
MQTT_HOST=GANTI_DENGAN_HOST_DEPLOYMENT_EMQX
MQTT_PORT=8883
MQTT_BACKEND_USERNAME=lumacurtain-backend
MQTT_BACKEND_PASSWORD=GANTI_DENGAN_PASSWORD_BACKEND
MQTT_BACKEND_CLIENT_ID=lumacurtain-backend
# Opsional: path CA certificate jika Node.js tidak memakai CA trust store standar.
MQTT_CA_CERT_PATH=

# EMQX Cloud Deployment API v5 untuk provisioning dan rotasi kredensial device.
# Buat App ID/App Secret dengan izin minimum untuk auth users dan authorization rules.
MQTT_CLOUD_API_URL=https://GANTI_DENGAN_API_ENDPOINT_DEPLOYMENT
MQTT_CLOUD_APP_ID=GANTI_DENGAN_APP_ID
MQTT_CLOUD_APP_SECRET=GANTI_DENGAN_APP_SECRET
